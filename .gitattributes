# Text files: Git stores them with LF endings, so a Windows checkout can't break what runs on the Pi.
* text=auto

# These must stay LF on every machine: bash and systemd refuse files with CRLF endings.
*.sh               text eol=lf
*.service          text eol=lf
*.path             text eol=lf
*.timer            text eol=lf
*.container        text eol=lf
*.network          text eol=lf
*.volume           text eol=lf
*.rules            text eol=lf
*.conf             text eol=lf
Containerfile      text eol=lf
.containerignore   text eol=lf

# Windows-only files keep Windows line endings
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source and docs: LF as well, so diffs stay clean
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.ini  text eol=lf
*.json text eol=lf

# Large binaries go to Git LFS (run `git lfs install` once on the machine first).
# Nothing in the project needs this today; it is here for photos, wiring diagrams,
# firmware and ready-made SD card images you may add later.
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.pdf  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
*.bin  filter=lfs diff=lfs merge=lfs -text
